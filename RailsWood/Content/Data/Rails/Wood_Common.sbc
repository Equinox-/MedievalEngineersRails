<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://storage.googleapis.com/unofficial-keen-schemas/latest/medieval-modded.xsd">
    <Definition xsi:type="MyObjectBuilder_RailSegmentDefinition">
        <Id Type="MyObjectBuilder_RailSegmentComponent" Subtype="RailWood" />
        <Capabilities>
            <Capability ActivationLevel="0.95" Friction="4" MaxSpeed="8" Gauge="1.435" />
        </Capabilities>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_RailGradeComponentDefinition">
        <Id Type="MyObjectBuilder_RailGradeComponent" Subtype="RailWood" />
        <CopyFrom Type="MyObjectBuilder_RailGradeComponent" Subtype="RailStandardGauge" />
    </Definition>
</Definitions>